{
  "name": "pulsar-music-player",
  "version": "1.1.0",
  "homepage": "https://github.com/pulsar/player",
  "description": "Premium 100% Offline MP3 Music Player for Linux with Custom Playlists, 10-Band EQ, and Audio Visualizer",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "ELECTRON_DEV=true electron .",
    "build:deb": "bash scripts/build_deb.sh",
    "build:win": "bash scripts/build_win.sh"
  },
  "keywords": [
    "mp3",
    "music-player",
    "audio",
    "linux",
    "offline",
    "equalizer",
    "playlists",
    "visualizer"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.6.0",
    "electron-builder": "^24.13.3",
    "puppeteer-core": "^24.43.1",
    "vite": "^5.4.8"
  },
  "build": {
    "appId": "com.pulsar.musicplayer",
    "productName": "Pulsar Music Player",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "bin/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/stream_resolver.py",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "linux": {
      "target": [
        "deb"
      ],
      "category": "AudioVideo;Audio;Player;",
      "icon": "build/icons/icon.png",
      "maintainer": "Pulsar Audio <support@pulsaraudio.local>",
      "synopsis": "Offline MP3 Music Player with Custom Playlists & 10-Band EQ",
      "description": "High-fidelity offline music player featuring custom playlist management, real-time 60FPS audio visualizer, 10-band equalizer, ID3 metadata reader, and Linux desktop integration.",
      "mimeTypes": [
        "audio/mpeg",
        "audio/mp3",
        "audio/flac",
        "audio/x-wav",
        "audio/ogg",
        "audio/aac",
        "audio/x-m4a"
      ]
    },
    "deb": {
      "packageCategory": "sound",
      "priority": "optional",
      "depends": [
        "libnotify4",
        "libasound2 | libasound2t64"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pulsar Music Player"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  }
}
